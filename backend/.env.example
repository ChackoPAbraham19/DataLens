# Copy to backend/.env and fill in. All values are optional.

# Kaggle API credentials — required only for the Kaggle ingestion endpoint.
# Create a token at https://www.kaggle.com/settings/account
KAGGLE_USERNAME=
KAGGLE_KEY=

# Anthropic API key — enables AI-generated insights. Without it, DataLens
# still returns the rule-based quality score, warnings and suggestions.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
